# 复制为 .env 或通过 systemd/容器注入环境变量
YU_ADDR=:8080
YU_DATABASE_URL=postgres://yu:yu@127.0.0.1:5432/yu?sslmode=disable
YU_PUBLIC_BASE_URL=http://localhost:8080
YU_ALLOWED_ORIGINS=http://localhost:5173
YU_SECURE_COOKIES=false
YU_SESSION_TTL=720h
YU_BOOTSTRAP_EMAIL=admin@example.com
YU_BOOTSTRAP_PASSWORD=change-me-please
YU_BOOTSTRAP_WORKSPACE=默认工作区
YU_PROBE_CONCURRENCY=32
